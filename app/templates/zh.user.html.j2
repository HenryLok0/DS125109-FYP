{% extends "zh.base.html.j2" %}
{% block title %}{{ user.username }} - 泊易香港{% endblock %}
{% block app_content %}
    <div class="profile-card">
        <img src="{{ user.avatar(256) }}" alt="{{ user.username }}">
        <div>
            <p class="page-kicker">個人資料</p>
            <h1>{{ user.username }}</h1>
            {% if user.about_me %}<p>{{ user.about_me }}</p>{% endif %}
            {% if user.last_seen %}<p class="page-lead">{{ _('最後一次上線時間') }}: {{ moment(user.last_seen).format('LLL') }}</p>{% endif %}
            <p>{{ _('%(count)d 位粉絲', count=user.followers.count()) }}，{{ _('%(count)d 位關注中', count=user.followed.count()) }}</p>
            {% if user == current_user %}
                <a class="btn btn-primary" href="{{ '/zh' + url_for('edit_profile') }}">{{ _('編輯個人資料') }}</a>
            {% elif not current_user.is_following(user) %}
                <a class="btn btn-primary" href="{{ url_for('follow', username=user.username) }}">{{ _('關注') }}</a>
            {% else %}
                <a class="btn btn-default" href="{{ url_for('unfollow', username=user.username) }}">{{ _('取消關注') }}</a>
            {% endif %}
        </div>
    </div>
{% endblock %}
