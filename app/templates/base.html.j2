{% extends 'bootstrap/base.html' %}
{% block html_attribs %} lang="en"{% endblock %}

{% block styles %}
    {{ super() }}
    <link rel="icon" href="{{ url_for('static', filename='favicon.svg') }}" type="image/svg+xml">
    <link rel="shortcut icon" href="{{ url_for('static', filename='favicon.svg') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/theme.css') }}?v=7">
    <script>
        (function () {
            try {
                if (localStorage.getItem('darkMode') === 'enabled') {
                    document.documentElement.classList.add('dark-mode');
                }
            } catch (e) {}
        })();
    </script>
{% endblock %}

{% block title %}
    {% if title %}{{ title }} - EaseParkHK{% else %}EaseParkHK{% endif %}
{% endblock %}

{% block navbar %}
    <nav class="navbar navbar-default site-navbar">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#easepark-navbar" aria-expanded="false">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand" href="/">
                    {% include "favicon.html.j2" %}
                    EaseParkHK
                </a>
            </div>
            <div class="collapse navbar-collapse" id="easepark-navbar">
                {% include "indexbase.html.j2" %}
            </div>
        </div>
    </nav>
{% endblock %}

{% block content %}
    <div class="site-search-wrap">
        <div class="container">
            {% include "search_bar.html.j2" %}
        </div>
    </div>
    <main class="site-main">
        <div class="container">
            {% with messages = get_flashed_messages() %}
                {% if messages %}
                    {% for message in messages %}
                        <div class="alert alert-info" role="alert">{{ message }}</div>
                    {% endfor %}
                {% endif %}
            {% endwith %}
            {% block app_content %}{% endblock %}
        </div>
    </main>
    <footer class="site-footer">
        <div class="container">
            EaseParkHK · Live Hong Kong car park vacancy
            {% if coverage %}
                · Coverage {{ coverage.percent }}%
            {% endif %}
            ·
            <a href="/privacy_policy">Privacy Policy</a>
        </div>
    </footer>
    {% include "chatbox.html.j2" %}
{% endblock %}

{% block scripts %}
    {{ super() }}
    {{ moment.include_moment() }}
    {{ moment.lang(g.locale) }}
    <script src="{{ url_for('static', filename='js/carpark-list.js') }}?v=2"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const body = document.body;
            const html = document.documentElement;
            const toggle = document.getElementById('theme-toggle');
            const icon = toggle ? toggle.querySelector('.night-mode-icon') : null;

            function applyTheme(isDark) {
                html.classList.toggle('dark-mode', isDark);
                body.classList.toggle('dark-mode', isDark);
                if (icon) {
                    icon.className = isDark
                        ? 'glyphicon glyphicon-sun night-mode-icon'
                        : 'glyphicon glyphicon-adjust night-mode-icon';
                }
            }

            applyTheme(localStorage.getItem('darkMode') === 'enabled');

            if (toggle) {
                toggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    const isDark = !body.classList.contains('dark-mode');
                    localStorage.setItem('darkMode', isDark ? 'enabled' : 'disabled');
                    applyTheme(isDark);
                });
            }

            document.addEventListener('click', function (event) {
                const link = event.target.closest && event.target.closest('.navbar-collapse a');
                if (!link || link.classList.contains('dropdown-toggle') || window.innerWidth >= 768) {
                    return;
                }
                document.querySelectorAll('.navbar-collapse.in').forEach(function (menu) {
                    if (window.jQuery) {
                        window.jQuery(menu).collapse('hide');
                    }
                });
            });

            // Keep a single chat widget if older pages still embed another copy
            document.querySelectorAll('#chatbox-button').forEach(function (el, i) {
                if (i > 0) el.remove();
            });
            document.querySelectorAll('#chatbox-popup').forEach(function (el, i) {
                if (i > 0) el.remove();
            });
        });
    </script>
{% endblock %}
