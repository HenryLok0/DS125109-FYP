<div id="chatbox-button">
    <button type="button" class="chatbox-btn" onclick="toggleChatbox()" aria-label="Chat with AI">
        <span class="chatbox-icon">&#128172;</span>
    </button>
</div>
<div id="chatbox-popup" class="chatbox-popup">
    <div class="chatbox-header">
        <h5>{% if request.path.startswith('/zh') %}泊車助手{% else %}Parking assistant{% endif %}</h5>
        <button type="button" class="btn btn-sm btn-default" onclick="toggleChatbox()">
            {% if request.path.startswith('/zh') %}關閉{% else %}Close{% endif %}
        </button>
    </div>
    <iframe id="chatbox-frame" data-src="{{ url_for('ai_chatbox') }}" title="AI chat" width="100%" height="100%" frameborder="0"></iframe>
</div>
<script>
    var CHAT_OPEN_KEY = "easepark-chat-open";

    function setChatboxOpen(isOpen) {
        const popup = document.getElementById("chatbox-popup");
        const frame = document.getElementById("chatbox-frame");
        if (!popup) return;
        popup.style.display = isOpen ? "flex" : "none";
        try {
            sessionStorage.setItem(CHAT_OPEN_KEY, isOpen ? "1" : "0");
        } catch (error) {}
        if (isOpen && frame && !frame.getAttribute("src") && frame.dataset.src) {
            frame.src = frame.dataset.src;
        }
    }

    function toggleChatbox() {
        const popup = document.getElementById("chatbox-popup");
        if (!popup) return;
        setChatboxOpen(popup.style.display !== "flex");
    }

    try {
        if (sessionStorage.getItem(CHAT_OPEN_KEY) === "1") {
            setChatboxOpen(true);
        }
    } catch (error) {}
</script>
