{% extends "zh.base.html.j2" %}
{% import 'bootstrap/wtf.html' as wtf %}
{% block title %}{{ carpark.name_tc }} - 泊易香港{% endblock %}
{% block app_content %}
    <div class="page-header-lite">
        <p class="page-kicker">停車場</p>
        <h1>{{ carpark.name_tc }}</h1>
        <p class="page-lead">{{ carpark.displayAddress_tc }}</p>
    </div>

    <div class="detail-hero">
        {% if carpark.carpark_photo %}
            <img src="{{ carpark.carpark_photo }}" alt="{{ carpark.name_tc }}" class="carpark-photo">
        {% endif %}
        <div class="detail-facts">
            <p><strong>地址</strong> {{ carpark.displayAddress_tc }}</p>
            <p><strong>聯絡電話</strong> {{ carpark.contactNo or '—' }}</p>
            <p>
                <strong>網站</strong>
                {% if carpark.website_en %}
                    <a href="{{ carpark.website_en }}" target="_blank" rel="noopener">{{ carpark.website_tc or carpark.website_en }}</a>
                {% else %}
                    —
                {% endif %}
            </p>
            <p><strong>營運狀態</strong> {{ carpark.opening_status }}</p>
            <a id="view-map-button" onclick="showMap('{{ carpark.latitude }}', '{{ carpark.longitude }}')">查看地圖</a>
        </div>
    </div>

    <h2>空位</h2>
    <div class="vacancy-grid">
        {% for item in carpark.vacancy_data %}
            <div class="vacancy-card">
                <span class="vacancy-label">{{ item.type }}</span>
                <span class="vacancy-value">{{ item.vacancy }}</span>
                <span class="vacancy-meta">更新於 {{ item.last_update }}</span>
            </div>
        {% else %}
            <p class="page-lead">此停車場暫無空位資料。</p>
        {% endfor %}
    </div>

    <div id="map-container" class="detail-map" style="display: none;">
        <iframe id="map" title="地圖" style="width: 100%; height: 100%; border: none;"></iframe>
    </div>

    <script>
        function showMap(latitude, longitude) {
            var mapIframe = document.getElementById('map');
            mapIframe.src = 'https://maps.google.com/?q=' + latitude + ',' + longitude + '&output=embed';
            document.getElementById('map-container').style.display = 'block';
        }
        window.addEventListener('load', function () {
            var btn = document.getElementById('view-map-button');
            if (btn) btn.click();
        });
    </script>
{% endblock %}
