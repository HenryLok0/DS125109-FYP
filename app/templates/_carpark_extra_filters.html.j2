{% if filter_lang == 'zh' %}
<div class="form-group">
    <label for="operator-filter">營辦商</label>
    <select id="operator-filter" class="form-control" onchange="filterCarParks()">
        <option value="all">全部</option>
        <option value="private">私人／商場</option>
        <option value="government">政府／公營</option>
    </select>
</div>
<div class="form-group">
    <label for="source-filter">資料來源</label>
    <select id="source-filter" class="form-control" onchange="filterCarParks()">
        <option value="live">即時空位</option>
        <option value="all">全部列出</option>
        <option value="map">地圖位置（無即時空位）</option>
    </select>
</div>
{% else %}
<div class="form-group">
    <label for="operator-filter">Operator</label>
    <select id="operator-filter" class="form-control" onchange="filterCarParks()">
        <option value="all">All</option>
        <option value="private">Private / mall</option>
        <option value="government">Government</option>
    </select>
</div>
<div class="form-group">
    <label for="source-filter">Listings</label>
    <select id="source-filter" class="form-control" onchange="filterCarParks()">
        <option value="live">Live vacancy</option>
        <option value="all">All listed</option>
        <option value="map">Map only (no live vacancy)</option>
    </select>
</div>
{% endif %}
