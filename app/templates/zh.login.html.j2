{% extends "zh.base.html.j2" %}
{% import 'bootstrap/wtf.html' as wtf %}
{% block title %}登入 - 泊易香港{% endblock %}
{% block app_content %}
    <div class="auth-page">
        <p class="page-kicker">帳戶</p>
        <h1>{{ _('登入') }}</h1>
        {{ wtf.quick_form(form) }}
        <div class="auth-links">
            <p>{{ _('新用戶?') }} <a href="/zh/register">{{ _('點擊註冊!') }}</a></p>
            <p>{{ _('忘記密碼?') }} <a href="{{ url_for('reset_password_request') }}">{{ _('點擊重設密碼') }}</a></p>
            <p>繼續使用即表示你同意<a href="/privacy_policy">{{ _('隱私政策') }}</a>。</p>
        </div>
    </div>
{% endblock %}
