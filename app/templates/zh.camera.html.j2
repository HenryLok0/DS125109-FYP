{% extends "zh.base.html.j2" %}
{% block title %}交通攝影機{% endblock %}
{% block app_content %}
    <div class="page-header-lite">
        <p class="page-kicker">即時影像</p>
        <h1>交通攝影機位置</h1>
        <p class="page-lead">先選擇地區以載入快照，點擊照片可放大。</p>
    </div>

    <div class="filter-panel">
        <div class="form-group">
            <label for="districtSelect">地區</label>
            <select id="districtSelect" class="form-control">
                <option value="">全部地區</option>
                <option value="中西區">中西區</option>
                <option value="東區">東區</option>
                <option value="南區">南區</option>
                <option value="灣仔區">灣仔區</option>
                <option value="離島區">離島區</option>
                <option value="葵青區">葵青區</option>
                <option value="北區">北區</option>
                <option value="西貢區">西貢區</option>
                <option value="沙田區">沙田區</option>
                <option value="大埔區">大埔區</option>
                <option value="荃灣區">荃灣區</option>
                <option value="屯門區">屯門區</option>
                <option value="元朗區">元朗區</option>
                <option value="九龍城區">九龍城區</option>
                <option value="觀塘區">觀塘區</option>
                <option value="深水埗區">深水埗區</option>
                <option value="黃大仙區">黃大仙區</option>
                <option value="油尖旺區">油尖旺區</option>
            </select>
        </div>
        <div class="form-group">
            <label for="descriptionSearch">搜尋</label>
            <input type="text" id="descriptionSearch" class="form-control" placeholder="按描述搜尋">
        </div>
    </div>

    <section id="favoritesSection" hidden>
        <h2>收藏</h2>
        <div id="favoritesGrid" class="camera-grid"></div>
    </section>

    <h2>攝影機</h2>
    <p id="cameraHint" class="page-lead">選擇地區或輸入關鍵字後顯示快照。</p>
    <div id="cameraGrid" class="camera-grid">
        {% for camera in cameras %}
            <article class="camera-card is-hidden"
                     data-camera-id="{{ camera.key }}"
                     data-district="{{ camera.district }}"
                     data-region="{{ camera.region }}"
                     data-description="{{ camera.description }}"
                     data-lat="{{ camera.latitude }}"
                     data-lng="{{ camera.longitude }}"
                     data-url="{{ camera.url }}">
                <button type="button" class="camera-card-image" data-action="preview">
                    <img data-src="{{ camera.url }}" alt="{{ camera.description }}" loading="lazy">
                </button>
                <div class="camera-card-body">
                    <h3>{{ camera.description }}</h3>
                    <p>{{ camera.region }} · {{ camera.district }}</p>
                    <div class="camera-card-actions">
                        <button type="button" class="btn btn-primary btn-sm" data-action="map">地圖</button>
                        <button type="button" class="btn btn-warning btn-sm favorite-btn" data-action="favorite">收藏</button>
                    </div>
                </div>
            </article>
        {% endfor %}
    </div>
    <p id="no-camera-results" class="page-lead" hidden>沒有符合條件的攝影機。</p>

    <div class="modal fade" id="cameraPreviewModal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="關閉"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="previewTitle">攝影機</h4>
                </div>
                <div class="modal-body">
                    <img id="previewImage" alt="">
                    <p id="previewMeta"></p>
                </div>
            </div>
        </div>
    </div>

    <div id="map-modal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="關閉"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="mapModalLabel">地圖</h4>
                </div>
                <div class="modal-body">
                    <iframe id="map" title="地圖" width="100%" height="400" frameborder="0" style="border:0" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>

    <script>
        const cameraGrid = document.getElementById('cameraGrid');
        const favoritesGrid = document.getElementById('favoritesGrid');
        const favoritesSection = document.getElementById('favoritesSection');
        const cameraHint = document.getElementById('cameraHint');
        const noResults = document.getElementById('no-camera-results');
        const districtSelect = document.getElementById('districtSelect');
        const descriptionSearch = document.getElementById('descriptionSearch');

        function loadImage(card) {
            const img = card.querySelector('img[data-src]');
            if (img && !img.getAttribute('src')) {
                img.src = img.getAttribute('data-src');
            }
        }

        function applyFilters() {
            const district = districtSelect.value;
            const searchText = descriptionSearch.value.trim().toLowerCase();
            let visible = 0;
            cameraGrid.querySelectorAll('.camera-card').forEach(function (card) {
                const matchesDistrict = !district || card.getAttribute('data-district') === district;
                const description = (card.getAttribute('data-description') || '').toLowerCase();
                const matchesSearch = !searchText || description.indexOf(searchText) !== -1;
                const show = matchesDistrict && matchesSearch && (district || searchText);
                card.classList.toggle('is-hidden', !show);
                if (show) {
                    loadImage(card);
                    visible += 1;
                }
            });
            cameraHint.hidden = Boolean(district || searchText);
            noResults.hidden = !(district || searchText) || visible > 0;
        }

        function toggleFavorite(card) {
            const cameraId = card.getAttribute('data-camera-id');
            const button = card.querySelector('.favorite-btn');
            const isFav = card.classList.contains('favorite');
            if (isFav) {
                card.classList.remove('favorite');
                button.textContent = '收藏';
                removeFavorite(cameraId);
                cameraGrid.appendChild(card);
                applyFilters();
            } else {
                card.classList.add('favorite');
                button.textContent = '取消收藏';
                addFavorite(cameraId);
                loadImage(card);
                card.classList.remove('is-hidden');
                favoritesGrid.appendChild(card);
            }
            favoritesSection.hidden = favoritesGrid.children.length === 0;
        }

        function addFavorite(cameraId) {
            let favorites = JSON.parse(sessionStorage.getItem('favorites')) || [];
            if (favorites.indexOf(cameraId) === -1) {
                favorites.push(cameraId);
                sessionStorage.setItem('favorites', JSON.stringify(favorites));
            }
        }

        function removeFavorite(cameraId) {
            let favorites = JSON.parse(sessionStorage.getItem('favorites')) || [];
            favorites = favorites.filter(function (id) { return id !== cameraId; });
            sessionStorage.setItem('favorites', JSON.stringify(favorites));
        }

        function loadFavorites() {
            const favorites = JSON.parse(sessionStorage.getItem('favorites')) || [];
            favorites.forEach(function (cameraId) {
                const card = document.querySelector('.camera-card[data-camera-id="' + cameraId + '"]');
                if (!card) return;
                card.classList.add('favorite');
                card.querySelector('.favorite-btn').textContent = '取消收藏';
                loadImage(card);
                card.classList.remove('is-hidden');
                favoritesGrid.appendChild(card);
            });
            favoritesSection.hidden = favoritesGrid.children.length === 0;
        }

        function openPreview(card) {
            loadImage(card);
            document.getElementById('previewTitle').textContent = card.getAttribute('data-description') || '攝影機';
            document.getElementById('previewImage').src = card.getAttribute('data-url');
            document.getElementById('previewMeta').textContent =
                (card.getAttribute('data-region') || '') + ' · ' + (card.getAttribute('data-district') || '');
            $('#cameraPreviewModal').modal('show');
        }

        function openMap(card) {
            const lat = card.getAttribute('data-lat');
            const lng = card.getAttribute('data-lng');
            const description = card.getAttribute('data-description') || '';
            document.getElementById('map').src = 'https://www.google.com/maps?q=' + lat + ',' + lng + '&output=embed';
            document.getElementById('mapModalLabel').textContent = description;
            $('#map-modal').modal('show');
        }

        districtSelect.addEventListener('change', applyFilters);
        descriptionSearch.addEventListener('input', applyFilters);

        document.addEventListener('click', function (event) {
            const actionBtn = event.target.closest('[data-action]');
            if (!actionBtn) return;
            const card = actionBtn.closest('.camera-card');
            if (!card) return;
            const action = actionBtn.getAttribute('data-action');
            if (action === 'preview') openPreview(card);
            if (action === 'map') openMap(card);
            if (action === 'favorite') toggleFavorite(card);
        });

        document.addEventListener('DOMContentLoaded', function () {
            loadFavorites();
            applyFilters();
        });
    </script>
{% endblock %}
