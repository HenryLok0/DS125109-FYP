{% extends 'bootstrap/base.html' %}
{% block html_attribs %} lang="zh-HK"{% endblock %}
{% import 'bootstrap/wtf.html' as wtf %}
{% block title %}
    {% if title %}
        {{ title }} - 泊易香港 (EaseParkHK)
    {% else %}
        {{ _('泊易香港 (EaseParkHK)') }}
    {% endif %}
{% endblock %}
{% block styles %}
    {{ super() }}
    <link rel="icon" href="{{ url_for('static', filename='favicon.svg') }}" type="image/svg+xml">
    <link rel="shortcut icon" href="{{ url_for('static', filename='favicon.svg') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/mobile.css') }}?v=5">
    <style>
        /* Light mode: reset dark leftovers (thead-dark, inline styles, inherited colors) */
        body:not(.dark-mode) {
            background-color: #ffffff;
            color: #333333;
        }

        body:not(.dark-mode) .table,
        body:not(.dark-mode) .table > tbody > tr > td,
        body:not(.dark-mode) .table > tbody > tr > th,
        body:not(.dark-mode) .table > thead > tr > th {
            background-color: #ffffff;
            color: #333333;
            border-color: #ddd;
        }

        body:not(.dark-mode) .table-striped > tbody > tr:nth-of-type(odd) {
            background-color: #f9f9f9;
        }

        body:not(.dark-mode) .table-striped > tbody > tr:nth-of-type(even) {
            background-color: #ffffff;
        }

        body:not(.dark-mode) .table-hover > tbody > tr:hover {
            background-color: #f5f5f5;
        }

        body:not(.dark-mode) .thead-dark th {
            background-color: #f5f5f5 !important;
            color: #333333 !important;
            border-color: #ddd !important;
        }

        body:not(.dark-mode) .form-control {
            background-color: #ffffff !important;
            color: #333333 !important;
            border-color: #ccc !important;
        }

        body:not(.dark-mode) label,
        body:not(.dark-mode) h1,
        body:not(.dark-mode) h2,
        body:not(.dark-mode) h3,
        body:not(.dark-mode) h4,
        body:not(.dark-mode) p {
            color: #333333;
        }

        body:not(.dark-mode) a {
            color: #337ab7;
        }

        body:not(.dark-mode) .modal-content {
            background-color: #ffffff;
            color: #333333;
            border-color: #ddd;
        }

        body:not(.dark-mode) .close {
            color: #000000;
            text-shadow: 0 1px 0 #ffffff;
            opacity: 0.2;
        }

        /* Dark mode styles */
        body.dark-mode {
            background-color: #1a1a1a;
            color: #f5f5f5;
        }
        
        body.dark-mode .navbar-default {
            background-color: #333;
            border-color: #444;
        }
        
        body.dark-mode .navbar-default .navbar-brand,
        body.dark-mode .navbar-default .navbar-nav > li > a {
            color: #f5f5f5;
        }
        
        body.dark-mode .navbar-default .navbar-nav > .active > a, 
        body.dark-mode .navbar-default .navbar-nav > .active > a:focus, 
        body.dark-mode .navbar-default .navbar-nav > .active > a:hover {
            background-color: #444;
            color: #fff;
        }
        
        body.dark-mode .dropdown-menu {
            background-color: #333;
            border-color: #444;
        }
        
        body.dark-mode .dropdown-menu > li > a {
            color: #f5f5f5;
        }
        
        body.dark-mode .dropdown-menu > li > a:hover {
            background-color: #444;
            color: #fff;
        }
        
        body.dark-mode .table-striped > tbody > tr:nth-of-type(odd) {
            background-color: #2d2d2d;
        }
        
        body.dark-mode .table-striped > tbody > tr:nth-of-type(even) {
            background-color: #383838;
        }
        
        body.dark-mode .table > thead > tr > th,
        body.dark-mode .thead-dark th {
            background-color: #444 !important;
            color: #f5f5f5 !important;
            border-bottom-color: #555 !important;
        }
        
        body.dark-mode .btn-info {
            background-color: #0f5b94;
            border-color: #0a4b7d;
        }
        
        body.dark-mode .btn-primary {
            background-color: #2a579a;
            border-color: #1f4785;
        }
        
        body.dark-mode .btn-warning {
            background-color: #b37400;
            border-color: #996300;
        }
        
        body.dark-mode .alert-info {
            background-color: #1a3c5c;
            border-color: #153354;
            color: #d9edf7;
        }
        
        body.dark-mode .modal-content {
            background-color: #2d2d2d;
            border-color: #444;
        }
        
        body.dark-mode .modal-header {
            border-bottom-color: #444;
        }
        
        body.dark-mode .modal-footer {
            border-top-color: #444;
        }
        
        .table-responsive {
            width: 100%;
            overflow-x: auto;
        }

        .navbar-favicon {
            display: inline-block;
            vertical-align: middle;
            margin: 0 8px 0 0;
        }
        .navbar-brand {
            display: flex;
            align-items: center;
        }
    </style>
{% endblock %}
{% block navbar %}
    <nav class="navbar navbar-default">
        <div class="container">
            <div class="navbar-header">
                <!-- Add a brand or toggle button if necessary -->
            </div>
            
            {% include "zh.indexbase.html.j2" %}
            {% include "zh.search_bar.html.j2" %}
        </div>
    </nav>
    <div class="container">
        {% with messages = get_flashed_messages() %}
            {% if messages %}
                {% for message in messages %}<div class="alert alert-info" role="alert">{{ message }}</div>{% endfor %}
            {% endif %}
        {% endwith %}
        {% block app_content %}{% endblock %}
    </div>
{% endblock %}
{% block scripts %}
    {{ super() }}
    {{ moment.include_moment() }}
    {{ moment.lang(g.locale) }}
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const body = document.body;
            const darkModeToggle = document.getElementById('dark-mode-toggle');
            if (!darkModeToggle) {
                return;
            }
            const icon = darkModeToggle.querySelector('span');
            
            // 檢查是否已啟用暗黑模式
            if (localStorage.getItem('darkMode') === 'enabled') {
                body.classList.add('dark-mode');
                icon.className = 'glyphicon glyphicon-sun night-mode-icon';
            }
            
            // Toggle dark/light mode and clear leftover inline styles
            darkModeToggle.addEventListener('click', function(e) {
                e.preventDefault();
                
                if (body.classList.contains('dark-mode')) {
                    body.classList.remove('dark-mode');
                    localStorage.setItem('darkMode', 'disabled');
                    icon.className = 'glyphicon glyphicon-adjust night-mode-icon';
                } else {
                    body.classList.add('dark-mode');
                    localStorage.setItem('darkMode', 'enabled');
                    icon.className = 'glyphicon glyphicon-sun night-mode-icon';
                }

                if (typeof applyDarkModeStyles === 'function') {
                    applyDarkModeStyles(body.classList.contains('dark-mode'));
                }
            });
            
            // 根據系統偏好設置初始模式
            const prefersDarkScheme = window.matchMedia('(prefers-color-scheme: dark)');
            if (!localStorage.getItem('darkMode') && prefersDarkScheme.matches) {
                body.classList.add('dark-mode');
                localStorage.setItem('darkMode', 'enabled');
                icon.className = 'glyphicon glyphicon-sun night-mode-icon';
            }
        });

        document.addEventListener('click', function(event) {
            const link = event.target.closest && event.target.closest('.navbar-collapse a');
            if (!link || link.classList.contains('dropdown-toggle') || window.innerWidth >= 768) {
                return;
            }
            const openMenus = document.querySelectorAll('.navbar-collapse.in');
            openMenus.forEach(function(menu) {
                if (window.jQuery) {
                    window.jQuery(menu).collapse('hide');
                }
            });
        });
    </script>
{% endblock %}