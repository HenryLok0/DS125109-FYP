{% extends "zh.base.html.j2" if chinese else "base.html.j2" %}
{% block title %}{% if chinese %}一站式泊車空位{% else %}One-stop parking vacancy{% endif %}{% endblock %}
{% block app_content %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css">
<link rel="stylesheet" href="/onestop.css">
<div class="onestop-page">
    <h1>{% if chinese %}一站式泊車空位{% else %}One-stop parking vacancy{% endif %}</h1>
    <p class="onestop-note">
        {% if chinese %}
        停車場空位、咪錶位置同交通快拍喺同一張圖。咪錶只有位置，沒有即時空位。
        {% else %}
        Car parks, meter locations, and cameras share one map. Meters show a location, not a live space count.
        {% endif %}
    </p>
    <div id="onestop-root"
         data-lang="{{ 'zh' if chinese else 'en' }}"
         data-history="/api/vacancy-history"
         data-detail-base="{{ '/zh/carpark/' if chinese else '/carpark/' }}"
         data-favorite-endpoint="/toggle_favorite/"
         data-favorites="{{ favorite_ids|tojson|e }}">
        <div class="onestop-filters">
            <label>{% if chinese %}車種{% else %}Vehicle{% endif %}
                <select id="vehicle-filter">
                    <option value="privateCar">{% if chinese %}私家車{% else %}Private car{% endif %}</option>
                    <option value="motorCycle">{% if chinese %}電單車{% else %}Motorcycle{% endif %}</option>
                </select>
            </label>
            <label><input type="checkbox" id="filter-open"> {% if chinese %}只顯示營業中{% else %}Open only{% endif %}</label>
            <label><input type="checkbox" id="filter-space"> {% if chinese %}只顯示有位{% else %}With a space{% endif %}</label>
            <label>{% if chinese %}地區{% else %}District{% endif %}
                <select id="district-filter">
                    <option value="">{% if chinese %}全部地區{% else %}All districts{% endif %}</option>
                </select>
            </label>
        </div>
        <div class="onestop-layers">
            <label><input type="checkbox" id="layer-parks" checked disabled> {% if chinese %}停車場{% else %}Car parks{% endif %}</label>
            <label><input type="checkbox" id="layer-meters"> {% if chinese %}咪錶位置{% else %}Meter locations{% endif %}</label>
            <label><input type="checkbox" id="layer-cameras"> {% if chinese %}交通快拍{% else %}Cameras{% endif %}</label>
        </div>
        <p id="filter-empty" class="onestop-note" hidden>
            {% if chinese %}這個篩選冇場。可以取消「有位」或「營業中」。{% else %}Nothing matches. Turn off open-only or with-a-space.{% endif %}
        </p>
        <div class="onestop-layout">
            <div id="onestop-map"></div>
            <aside class="onestop-side">
                <h2 id="notice-title">{% if chinese %}地區通告{% else %}District notices{% endif %}</h2>
                <div id="notice-list">{% if chinese %}點一個停車場，或先選地區。{% else %}Click a car park or choose a district.{% endif %}</div>
            </aside>
        </div>
        <div class="onestop-legend">
            <span class="legend-many">{% if chinese %}50 個或以上{% else %}50 or more{% endif %}</span>
            <span class="legend-some">{% if chinese %}10 至 49 個{% else %}10 to 49{% endif %}</span>
            <span class="legend-few">{% if chinese %}少於 10 個{% else %}Under 10{% endif %}</span>
            <span class="legend-meter">{% if chinese %}咪錶{% else %}Meter{% endif %}</span>
            <span class="legend-camera">{% if chinese %}快拍{% else %}Camera{% endif %}</span>
        </div>
    </div>
</div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
<script src="/advisor.js"></script>
<script src="/onestop.js"></script>
{% endblock %}