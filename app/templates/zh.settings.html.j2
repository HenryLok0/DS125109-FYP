{% extends "zh.base.html.j2" %}
{% import 'bootstrap/wtf.html' as wtf %}
{% block title %}設定 - 泊易香港{% endblock %}
{% block app_content %}
    <div class="settings-card">
        <p class="page-kicker">帳戶</p>
        <h1>設定</h1>
        {% if current_user.is_authenticated %}
            <form action="{{ url_for('settings') }}" method="post">
                <div class="form-group">
                    <label for="username">用戶名</label>
                    <input type="text" class="form-control" id="username" name="username" value="{{ current_user.username }}" placeholder="輸入用戶名">
                </div>
                <div class="form-group">
                    <label for="email">電郵</label>
                    <input type="email" class="form-control" id="email" name="email" value="{{ current_user.email }}" placeholder="輸入電郵">
                </div>
                <button type="submit" class="btn btn-primary">更新</button>
            </form>
        {% else %}
            <div class="alert alert-warning" role="alert">請先登入才能更改設定。</div>
            <a href="/zh/login" class="btn btn-primary">登入</a>
        {% endif %}
    </div>
{% endblock %}
