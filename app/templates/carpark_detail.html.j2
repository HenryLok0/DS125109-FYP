{% extends "base.html.j2" %}
{% import 'bootstrap/wtf.html' as wtf %}
{% block title %}{{ carpark.name }} - EaseParkHK{% endblock %}
{% block app_content %}
    <div class="page-header-lite">
        <p class="page-kicker">Car park</p>
        <h1>{{ carpark.name }}</h1>
        <p class="page-lead">{{ carpark.displayAddress }}</p>
    </div>

    <div class="detail-hero">
        {% if carpark.renditionUrls and carpark.renditionUrls.carpark_photo %}
            <img src="{{ carpark.renditionUrls.carpark_photo }}" alt="{{ carpark.name }}" class="carpark-photo">
        {% endif %}
        <div class="detail-facts">
            <p><strong>Address</strong> {{ carpark.displayAddress }}</p>
            <p><strong>Contact</strong> {{ carpark.contactNo or '—' }}</p>
            <p>
                <strong>Website</strong>
                {% if carpark.website %}
                    <a href="{{ carpark.website }}" target="_blank" rel="noopener">{{ carpark.website }}</a>
                {% else %}
                    —
                {% endif %}
            </p>
            <p><strong>Status</strong> {{ carpark.opening_status }}</p>
            <p><strong>Operator</strong> {{ carpark.operator_label or '—' }}</p>
            {% if not carpark.has_live_vacancy %}
            <p class="page-lead">This listing comes from OpenStreetMap. Live vacancy is not published for this car park.</p>
            {% endif %}
            <a id="view-map-button" onclick="showMap('{{ carpark.latitude }}', '{{ carpark.longitude }}')">View on map</a>
        </div>
    </div>

    <h2>Vacancy</h2>
    <div class="vacancy-grid">
        {% for item in carpark.vacancy_data %}
            <div class="vacancy-card">
                <span class="vacancy-label">{{ item.type }}</span>
                <span class="vacancy-value">{{ item.vacancy }}</span>
                <span class="vacancy-meta">Updated {{ item.last_update }}</span>
            </div>
        {% else %}
            <p class="page-lead">No vacancy data for this car park.</p>
        {% endfor %}
    </div>

    <div id="map-container" class="detail-map" style="display: none;">
        <iframe id="map" title="Map" style="width: 100%; height: 100%; border: none;"></iframe>
    </div>

    <script>
        function showMap(latitude, longitude) {
            var mapIframe = document.getElementById('map');
            mapIframe.src = 'https://maps.google.com/?q=' + latitude + ',' + longitude + '&output=embed';
            document.getElementById('map-container').style.display = 'block';
        }
        window.addEventListener('load', function () {
            var btn = document.getElementById('view-map-button');
            if (btn) btn.click();
        });
    </script>
{% endblock %}
