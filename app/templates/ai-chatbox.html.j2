<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>EaseParkHK parking assistant</title>
    <style>
        html, body {
            margin: 0;
            height: 100%;
            background: #fff;
        }
        body {
            font-family: "Segoe UI", "Noto Sans TC", "PingFang HK", "Microsoft JhengHei", sans-serif;
        }
        .chat-container {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            background: #fff;
            overflow: hidden;
        }
        .chat-box {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            border-bottom: 1px solid #ddd;
            background: #f9f9f9;
        }
        .chat-message {
            margin-bottom: 15px;
            display: flex;
        }
        .chat-message .user {
            font-weight: bold;
        }
        .chat-message.user-message {
            justify-content: flex-end;
        }
        .chat-message.user-message .message-content {
            background: #007bff;
            color: #fff;
            padding: 10px;
            border-radius: 8px;
            max-width: 70%;
        }
        .chat-message.ai-message .message-content {
            background: #e0e0e0;
            color: #1c2430;
            padding: 10px;
            border-radius: 8px;
            max-width: 85%;
            white-space: pre-wrap;
        }
        .chat-hint {
            margin: 0;
            padding: 10px 14px;
            font-size: 0.85rem;
            color: #5e6a78;
            background: #fff;
            border-bottom: 1px solid #ddd;
        }
        .chat-input {
            display: flex;
            padding: 10px;
            background: #fff;
            border-top: 1px solid #ddd;
        }
        .chat-input input {
            flex: 1;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 1rem;
        }
        .chat-input button {
            padding: 10px 15px;
            border: none;
            background: #007bff;
            color: #fff;
            border-radius: 4px;
            margin-left: 10px;
            cursor: pointer;
            font-size: 1rem;
        }
        .chat-input button:hover {
            background: #0056b3;
        }
    </style>
</head>
<body>
    <div class="chat-container">
        <p class="chat-hint">講地區、車種，同埋今日或聽日。空位是政府即時數字。</p>
        <div class="chat-box" id="chat-box"></div>
        <div class="chat-input">
            <input type="text" id="chat-input" placeholder="例如：中環今日私家車同電單車" autocomplete="off">
            <button type="button" id="send-button" onclick="sendMessage()">傳送</button>
        </div>
    </div>

    <script src="/advisor.js"></script>
    <script>
        var STORAGE_KEY = 'easepark-chat-messages';
        try {
            var parentPath = window.parent.location.pathname || '';
            window.EASEPARK_DETAIL_BASE = parentPath.indexOf('/zh') === 0 ? '/zh/carpark/' : '/carpark/';
        } catch (error) {
            window.EASEPARK_DETAIL_BASE = '/zh/carpark/';
        }

        function loadMessages() {
            try {
                return JSON.parse(sessionStorage.getItem(STORAGE_KEY) || '[]');
            } catch (error) {
                return [];
            }
        }

        function saveMessages(items) {
            sessionStorage.setItem(STORAGE_KEY, JSON.stringify(items));
        }

        var messages = loadMessages();

        function appendMessage(cssClass, label, text, persist) {
            const chatBox = document.getElementById('chat-box');
            const row = document.createElement('div');
            row.className = 'chat-message ' + cssClass;
            const content = document.createElement('div');
            content.className = 'message-content';
            content.textContent = label + ' ' + text;
            row.appendChild(content);
            chatBox.appendChild(row);
            chatBox.scrollTop = chatBox.scrollHeight;
            if (persist !== false) {
                messages.push({ cssClass: cssClass, label: label, text: text });
                saveMessages(messages);
            }
        }

        messages.forEach(function (item) {
            appendMessage(item.cssClass, item.label, item.text, false);
        });

        function sendMessage() {
            const chatInput = document.getElementById('chat-input');
            const sendButton = document.getElementById('send-button');
            const message = chatInput.value.trim();
            if (!message) {
                return;
            }

            appendMessage('user-message', '你：', message);
            chatInput.value = '';
            sendButton.disabled = true;

            window.EasePark.answer(message)
            .then(function (reply) {
                appendMessage('ai-message', '助手：', reply || '暫時未能回答。');
            })
            .catch(function () {
                appendMessage('ai-message', '助手：', '連線失敗，請再試一次。');
            })
            .finally(function () {
                sendButton.disabled = false;
                chatInput.focus();
            });
        }

        document.getElementById('chat-input').addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
                sendMessage();
            }
        });
    </script>
</body>
</html>