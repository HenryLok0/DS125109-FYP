<div class="custom-search-bar">
    <form class="form-inline" action="{{ url_for('result') }}" style="width: 100%; display: flex;">
        <input type="text" id="searchInput" name="p" value="{{ search_query | default('') }}" placeholder="Search for a car park" aria-label="Search" autocomplete="off" oninput="showSuggestions()">
        <button class="btn search-btn" type="submit">Search</button>
    </form>
    <div id="suggestions" class="suggestions"></div>
</div>
<script>
    (function () {
        const API_URL = "{{ url_for('carpark_suggest') }}";
        let cachedData = [];
        let lastQuery = "";

        window.showSuggestions = function () {
            const inputEl = document.getElementById("searchInput");
            const suggestions = document.getElementById("suggestions");
            if (!inputEl || !suggestions) return;
            const input = inputEl.value.trim().toLowerCase();
            suggestions.innerHTML = "";
            if (input.length === 0) {
                suggestions.style.display = "none";
                return;
            }
            if (input === lastQuery && cachedData.length) {
                renderSuggestions(inputEl, suggestions, cachedData);
                return;
            }
            lastQuery = input;
            fetch(API_URL + "?q=" + encodeURIComponent(input) + "&lang=en")
                .then(function (response) { return response.ok ? response.json() : []; })
                .then(function (data) {
                    cachedData = data || [];
                    renderSuggestions(inputEl, suggestions, cachedData);
                })
                .catch(function () {
                    suggestions.style.display = "none";
                });
        };

        function renderSuggestions(inputEl, suggestions, data) {
            suggestions.innerHTML = "";
            if (!data.length) {
                suggestions.style.display = "none";
                return;
            }
            data.forEach(function (item) {
                const div = document.createElement("div");
                div.textContent = item.name + " - " + (item.address || "");
                div.onclick = function () {
                    inputEl.value = item.name;
                    suggestions.style.display = "none";
                };
                suggestions.appendChild(div);
            });
            suggestions.style.display = "block";
        }

        document.addEventListener("click", function (event) {
            const suggestions = document.getElementById("suggestions");
            if (suggestions && event.target !== document.getElementById("searchInput")) {
                suggestions.style.display = "none";
            }
        });
    })();
</script>
