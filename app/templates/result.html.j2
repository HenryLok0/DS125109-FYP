{% extends "base.html.j2" %}
{% block title %}Search results - EaseParkHK{% endblock %}
{% block app_content %}
    <div class="page-header-lite">
        <p class="page-kicker">Search</p>
        <h1>Search results</h1>
        <p class="page-lead">Matching car parks for your query.</p>
    </div>
    {% if carparks %}
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Address</th>
                        <th>Price</th>
                    </tr>
                </thead>
                <tbody>
                    {% for carpark in carparks %}
                        <tr>
                            <td>{{ carpark['name'] }}</td>
                            <td>{{ carpark.get('displayAddress', '—') }}</td>
                            <td>{{ carpark.get('price', 'N/A') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="empty-state">
            <h1>No results</h1>
            <p class="page-lead">Try another car park name.</p>
            <p><a class="btn btn-primary" href="/">Back to home</a></p>
        </div>
    {% endif %}
{% endblock %}
