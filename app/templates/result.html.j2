{% extends "base.html.j2" %}
{% block title %}Search results - EaseParkHK{% endblock %}
{% block app_content %}
    <div class="page-header-lite">
        <p class="page-kicker">Search</p>
        <h1>Search results</h1>
        <p class="page-lead">Matching car parks for your query, including private operators and map-only listings.</p>
    </div>
    {% if carparks %}
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Address</th>
                        <th>Operator</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for carpark in carparks %}
                        <tr>
                            <td>
                                {{ carpark['name'] }}
                                <span class="park-badge park-badge-{{ carpark.operator_kind or 'private' }}">{{ carpark.operator_label or 'Private' }}</span>
                            </td>
                            <td>{{ carpark.get('displayAddress', '—') }}</td>
                            <td>{{ carpark.get('operator_label', '—') }}</td>
                            <td><a class="btn btn-info btn-sm" href="{{ url_for('carpark_detail', park_id=carpark.park_Id or carpark.park_id) }}">Details</a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="empty-state">
            <h1>No results</h1>
            <p class="page-lead">Try another car park name.</p>
            <p><a class="btn btn-primary" href="/">Back to home</a></p>
        </div>
    {% endif %}
{% endblock %}
